# Leave unset (or empty) to use Vite proxy — same origin as http://localhost:5173, no CORS issues.
# VITE_API_URL=
# Optional: point Vite's proxy at a different local backend port.
# VITE_PROXY_TARGET=http://127.0.0.1:8001
# Or call the API directly (requires backend CORS for localhost:5173):
# VITE_API_URL=http://127.0.0.1:8000
