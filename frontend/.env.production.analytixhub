# Build for https://app.analytixhub.ai/mdqm/
# Usage:
#   npx vite build --mode production.analytixhub
# Or copy these into CI env when deploying to analytixhub.
#
# Requires nginx to reverse-proxy API paths to FastAPI (see deploy/nginx-mdqm.conf).

VITE_BASE=/mdqm/
VITE_API_URL=https://app.analytixhub.ai
